{
  "name": "prism",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p . && tsc --noEmit -p server && tsc --noEmit -p apps/web",
    "app": "tsx app/server.ts",
    "probe:opgg": "tsx scripts/probe-opgg-mcp.ts",
    "server:dev": "wrangler dev --config server/wrangler.toml --local --ip 127.0.0.1 --port 8787",
    "server:migrate:local": "wrangler d1 migrations apply prism --local --config server/wrangler.toml",
    "server:migrate": "wrangler d1 migrations apply prism --remote --config server/wrangler.toml",
    "server:deploy": "wrangler deploy --config server/wrangler.toml",
    "data:mayhem": "tsx scripts/mayhem/build.ts",
    "site:build": "npm run web:build",
    "icons": "node scripts/fetch-icons.mjs",
    "web:dev": "npm run dev -w @prism/web",
    "web:build": "npm run icons && npm run build -w @prism/web"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "wrangler": "^4.149.0",
    "zod": "^4.6.5",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
