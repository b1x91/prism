{
  "hosting": {
    "site": "przm",
    "public": "apps/web/dist",
    "ignore": [
      "**/.*"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/download",
        "destination": "https://prism.tiny-term-ed35.workers.dev/app/download",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
