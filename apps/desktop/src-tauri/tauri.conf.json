{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.9.52",
  "identifier": "gg.przm.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prism",
        "width": 1280,
        "height": 1000,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://raw.communitydragon.org; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Prism 아수라장 동반 앱",
    "longDescription": "챔프 선택 도우미, 내 챔피언 증강 가이드, 증강 3개 비교, 내 아수라장 기록 자동 저장",
    "copyright": "Prism",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Korean"], "displayLanguageSelector": false }
    }
  }
}
